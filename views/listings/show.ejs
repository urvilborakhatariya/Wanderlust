<% layout("/layouts/boilerplate") %>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script>
    const mapToken = "<%= process.env.MAP_TOKEN %>";
    const listing = <%- JSON.stringify(listing) %>;
    const bookedDates = <%- JSON.stringify(bookedDates) %>;
</script>
    <body>
        <div class="row">
            <div class="col-8 offset-3">
                <h2 class="mt-3">
                    <%= listing.title %>
                </h2>

                <div class="card col-8 show-card listing-card">
                    <img src="<%=listing.image.url%>" class="card-img-top show-img" alt="listing-image">
                    <div class="card-body">
                        <p class="card-text">
                            <i>Owned by: <%= listing.owner.username %></i>
                        </p>
                        <p class="card-text">
                            <%= listing.description %>
                        </p>
                        <p class="card-text">&#8377; <%= listing.price.toLocaleString("en-IN")%>/night
                        <i> &nbsp; &nbsp; +18% GST </i>
                        </p>
                        <p class="card-text">
                            <%= listing.location %>
                        </p>
                        <p class="card-text">
                            <%= listing.country %>
                        </p>

                    </div>
                </div>
                <% if(currUser && currUser._id.equals(listing.owner._id)) {%>
                    <div class="btns mb-5">
                        <a class="btn btn-dark col-1 color-btn" href="/listings/<%=listing._id%>/edit">Edit</a>

                        <form method="post" action="/listings/<%=listing._id%>?_method=DELETE">
                            <button class="btn btn-dark offset-3">Delete</button>
                        </form>
                    </div>
                    <% } %>
                        <hr>
                        <div class="mb-3">
                            <h4>Book this listing</h4>
                            <% if(currUser) { %>
                                <form action="/listings/<%= listing._id %>/bookings" method="POST" class="needs-validation" novalidate id="booking-form">
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="startDate" class="form-label">Check-in</label>
                                            <input type="text" class="form-control" id="startDate" name="booking[startDate]" required placeholder="Select date">
                                            <div class="invalid-feedback">Please select a valid check-in date.</div>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="endDate" class="form-label">Check-out</label>
                                            <input type="text" class="form-control" id="endDate" name="booking[endDate]" required placeholder="Select date">
                                            <div class="invalid-feedback">Please select a valid check-out date.</div>
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <h5>Total: &#8377; <span id="totalPrice">0</span></h5>
                                    </div>
                                    <button class="btn btn-success">Book Now</button>
                                </form>
                            <% } else { %>
                                <p>Please <a href="/login">login</a> to book this listing.</p>
                            <% } %>
                        </div>
                        <hr>
                        <div class="mb-3">
                            <% if(currUser) { %>
                                <h4>Leave a Review</h4>
                                <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate
                                    class="needs-validation">
                                    <!-- <div class="mb-3 mt-3">
                                        <label for="rating" class="form-label">Rating</label>
                                        <input type="range" min="1" max="5" id="rating" name="review[rating]"
                                            class="form-range">
                                    </div> -->
                                    <div class="mt-3">
                                        <label for="rating" class="form-label mb-2">Rating</label>
                                        <fieldset class="starability-growRotate">
                                            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]"
                                                value="1" checked aria-label="No rating." />
                                            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                                            <label for="first-rate1" title="Terrible">1 star</label>
                                            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                                            <label for="first-rate2" title="Not good">2 stars</label>
                                            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                                            <label for="first-rate3" title="Average">3 stars</label>
                                            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                                            <label for="first-rate4" title="Very good">4 stars</label>
                                            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                                            <label for="first-rate5" title="Amazing">5 stars</label>
                                        </fieldset>
                                    </div>
                                    <div class="mb-3">
                                        <label for="comment" class="form-label">Comment</label>
                                        <textarea name="review[comment]" id="comment" cols="20" rows="6"
                                            class="form-control" required></textarea>
                                        <div class="invalid-feedback">
                                            Please enter a comment.
                                        </div>
                                    </div>
                                    <button class="btn btn-outline-dark">Submit</button>
                                </form>
                                <hr>
                                <% } %>

                                    <% if(listing.reviews.length> 0) {%>
                                        <div class="row">
                                            <p><b>All reviews</b></p>
                                            <% for(review of listing.reviews){ %>
                                                <div class="card col-5 mb-3 ms-3">
                                                    <div class="card-body">
                                                        <h5 class="card-title">@<%= review.author.username %>
                                                        </h5>
                                                        <div class="card-text">
                                                            <p class="starability-result"
                                                                data-rating="<%= review.rating %>">
                                                            </p>
                                                        </div>
                                                        <div class="card-text">
                                                            <%= review.comment %>
                                                        </div>

                                                        <% if(currUser && currUser._id.equals(review.author._id)) {%>
                                                            <form class="mb-3" method="post"
                                                                action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                                                                <button class="btn btn-dark btn-sm mt-2">Delete</button>
                                                            </form>
                                                            <% } %>

                                                    </div>
                                                </div>
                                                <% } %>
                                        </div>
                                        <% } %>

                        </div>
            </div>
            <div class="row col-8 offset-3 mb-3">
                <h3>Where you'll be</h3>
                <div id="map"></div>
            </div>
        </div>
    </body>

    <script src="/js/map.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const pricePerNight = listing.price;
            let checkInDate = null;
            let checkOutDate = null;

            const updatePrice = () => {
                if (checkInDate && checkOutDate) {
                    const diffTime = Math.abs(checkOutDate - checkInDate);
                    const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)); 
                    if(diffDays > 0) {
                        document.getElementById('totalPrice').innerText = (diffDays * pricePerNight).toLocaleString("en-IN");
                    } else {
                        document.getElementById('totalPrice').innerText = "0";
                    }
                } else {
                    document.getElementById('totalPrice').innerText = "0";
                }
            };

            const flatpickrConfig = {
                minDate: "today",
                disable: bookedDates,
                dateFormat: "Y-m-d",
            };

            const startPicker = flatpickr("#startDate", {
                ...flatpickrConfig,
                onChange: function(selectedDates, dateStr, instance) {
                    checkInDate = selectedDates[0];
                    if(checkInDate) {
                        endPicker.set("minDate", new Date(checkInDate.getTime() + 24 * 60 * 60 * 1000));
                    }
                    updatePrice();
                }
            });

            const endPicker = flatpickr("#endDate", {
                ...flatpickrConfig,
                onChange: function(selectedDates, dateStr, instance) {
                    checkOutDate = selectedDates[0];
                    updatePrice();
                }
            });
        });
    </script>