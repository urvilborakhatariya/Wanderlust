<% layout("/layouts/boilerplate") %>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script>
    const otherBookedDates = <%- JSON.stringify(otherBookedDates) %>;
    const pricePerNight = <%= booking.listing.price %>;
</script>

<div class="row mt-4">
    <div class="col-8 offset-2">
        <h3>Modify Your Booking: <%= booking.listing.title %></h3>
        <hr>
        
        <div class="mb-3">
            <form action="/bookings/<%= booking._id %>?_method=PUT" method="POST" class="needs-validation" novalidate id="booking-form">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="startDate" class="form-label">Check-in</label>
                        <input type="text" class="form-control" id="startDate" name="booking[startDate]" required placeholder="Select date" value="<%= booking.startDate.toISOString().split('T')[0] %>">
                        <div class="invalid-feedback">Please select a valid check-in date.</div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="endDate" class="form-label">Check-out</label>
                        <input type="text" class="form-control" id="endDate" name="booking[endDate]" required placeholder="Select date" value="<%= booking.endDate.toISOString().split('T')[0] %>">
                        <div class="invalid-feedback">Please select a valid check-out date.</div>
                    </div>
                </div>
                <div class="mb-3">
                    <h5>New Total: &#8377; <span id="totalPrice">0</span></h5>
                </div>
                <button class="btn btn-success">Save Changes</button>
                <a href="/bookings" class="btn btn-secondary ms-2">Back to My Bookings</a>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        let checkInDate = new Date(document.getElementById('startDate').value);
        let checkOutDate = new Date(document.getElementById('endDate').value);

        const updatePrice = () => {
            if (checkInDate && checkOutDate) {
                const diffTime = Math.abs(checkOutDate - checkInDate);
                const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)); 
                if(diffDays > 0) {
                    document.getElementById('totalPrice').innerText = (diffDays * pricePerNight).toLocaleString("en-IN");
                } else {
                    document.getElementById('totalPrice').innerText = "0";
                }
            } else {
                document.getElementById('totalPrice').innerText = "0";
            }
        };

        // Initialize price on load
        updatePrice();

        const flatpickrConfig = {
            minDate: "today",
            disable: otherBookedDates,
            dateFormat: "Y-m-d",
        };

        const startPicker = flatpickr("#startDate", {
            ...flatpickrConfig,
            onChange: function(selectedDates, dateStr, instance) {
                checkInDate = selectedDates[0];
                if(checkInDate) {
                    endPicker.set("minDate", new Date(checkInDate.getTime() + 24 * 60 * 60 * 1000));
                }
                updatePrice();
            }
        });

        const endPicker = flatpickr("#endDate", {
            ...flatpickrConfig,
            onChange: function(selectedDates, dateStr, instance) {
                checkOutDate = selectedDates[0];
                updatePrice();
            }
        });
    });
</script>
